# ==============================================================================
# NA PONTA DO LÁPIS — VARIÁVEIS DE AMBIENTE (CENTRALIZADAS)
# ==============================================================================
# Copie este arquivo para .env na raiz do projeto:
#   cp .env.example .env
# Todos os ambientes (Docker Compose, DevContainer e Bare Metal) lêem este arquivo.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Banco de Dados Local (Docker Compose / DevContainer)
# ------------------------------------------------------------------------------
# Utilizado ao rodar 'docker compose -f docker-compose.local.yml up'
POSTGRES_DB=npl_db
POSTGRES_USER=npl
POSTGRES_PASSWORD=troque_esta_senha

# ------------------------------------------------------------------------------
# 2. Conexão do Backend com Banco Externo (Opcional - ex: Supabase)
# ------------------------------------------------------------------------------
# Se descomentadas, o Spring Boot usará estas credenciais em vez do banco local padrão:
# DB_URL=jdbc:postgresql://aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# DB_USER=postgres.seu_projeto
# DB_PASSWORD=insira_sua_senha_do_banco_aqui

# ------------------------------------------------------------------------------
# 3. Segurança e Autenticação (JWT)
# ------------------------------------------------------------------------------
# Chave secreta usada para assinar os tokens JWT (mínimo 32 caracteres, recomendado 64+)
JWT_SECRET=na_ponta_do_lapis_dev_jwt_secret_key_super_segura_com_mais_de_256_bits_2026

# Duração do token de acesso (padrões: 1 dia, 1 hora, 5 minutos)
JWT_EXPIRE_DAYS=1
JWT_EXPIRE_HOURS=1
JWT_EXPIRE_MINUTES=5
# Duração do refresh token em dias (padrão: 7)
JWT_EXPIRE_REFRESH_DAYS=7

# ------------------------------------------------------------------------------
# 4. CORS (Origens permitidas para acessar a API)
# ------------------------------------------------------------------------------
# Separe múltiplas URLs por vírgula.
# Local: http://localhost:4200,http://localhost:8081 | Prod: https://napontadolapis.app
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8081

# ------------------------------------------------------------------------------
# 5. Integrações Externas (Cloudinary - Upload de Fotos e Comprovantes)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------------------
# 6. Inteligência Artificial (Leitura de Faturas PDF)
# ------------------------------------------------------------------------------
# Não há chave de IA aqui: cada usuário informa a própria chave na tela de
# importação de fatura (ela não é gravada no banco nem em variável de ambiente).

# ------------------------------------------------------------------------------
# 7. Carga de Dados Inicial (Seeder)
# ------------------------------------------------------------------------------
# Popula o banco apenas na 1ª vez, se ele estiver vazio.
# Local/Dev: true | Homologação: true | Produção: false
APP_SEED_ENABLED=true

# ------------------------------------------------------------------------------
# 8. Configurações de Deploy / Homologação / Produção (Coolify)
# ------------------------------------------------------------------------------
# Estas variáveis NÃO ficam no .env local: são configuradas no painel do Coolify
# (Environment Variables). O deploy/docker-compose.deploy.yml só as repassa ao
# container quando estão referenciadas no bloco "environment:".
#
# Variável                        Homologação   Produção
# APP_VERSION                     homolog       1.0.1
# SPRING_PROFILES_ACTIVE          prod          prod
# SPRING_JPA_HIBERNATE_DDLAUTO    update        validate
# APP_SEED_ENABLED                true          false
# APP_WEB_URL                     https://homolog.napontadolapis.app   https://napontadolapis.app
# SWAGGER_ENABLED                 true          false
