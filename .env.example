# ---------- Versão das imagens ----------
# homolog no ambiente de homologação | 1.0.0, 1.0.1... em produção
APP_VERSION=homolog

# ---------- Banco ----------
POSTGRES_DB=npl_db
POSTGRES_USER=npl
POSTGRES_PASSWORD=troque_esta_senha

# ---------- Backend ----------
SPRING_PROFILES_ACTIVE=prod
SPRING_JPA_HIBERNATE_DDLAUTO=update
JWT_SECRET=gere_com_openssl_rand_base64_64
# Web usa mesma origem e app nativo não usa CORS → na prática não é exercido,
# mas a variável é obrigatória (application-prod.properties usa ${CORS_ALLOWED_ORIGINS} sem default).
# Mobile em Ionic/Capacitor: acrescente ,capacitor://localhost,https://localhost
CORS_ALLOWED_ORIGINS=https://napontadolapis.app,https://www.napontadolapis.app
# true em homolog, false em produção
SWAGGER_ENABLED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GEMINI_API_KEY=
