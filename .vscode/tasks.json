{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Frontend: Angular",
      "type": "shell",
      "command": "npm start",
      "options": {
        "cwd": "${workspaceFolder}/frontend/na-ponta-do-lapis",
        "env": {
          "NG_CLI_ANALYTICS": "false"
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*Building.*|.*Generating browser application bundles.*",
          "endsPattern": ".*Application bundle generation complete.*|.*Compiled successfully.*|.*Local:.*http.*"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "dev"
      }
    },
    {
      "label": "Backend: Spring Boot",
      "type": "shell",
      "command": "sh ./mvnw spring-boot:run",
      "options": {
        "cwd": "${workspaceFolder}/backend/na-ponta-do-lapis"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": [
          {
            "regexp": ".",
            "file": 1,
            "location": 2,
            "message": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*Starting NaPontaDoLapisApplication.*|.*Building.*",
          "endsPattern": ".*Started NaPontaDoLapisApplication.*|.*Tomcat started on port.*"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "dev"
      }
    },
    {
      "label": "Backend: Spring Boot (H2)",
      "type": "shell",
      "command": "sh ./mvnw spring-boot:run -Dspring-boot.run.profiles=h2",
      "options": {
        "cwd": "${workspaceFolder}/backend/na-ponta-do-lapis"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": [
          {
            "regexp": ".",
            "file": 1,
            "location": 2,
            "message": 3
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*Starting NaPontaDoLapisApplication.*|.*Building.*",
          "endsPattern": ".*Started NaPontaDoLapisApplication.*|.*Tomcat started on port.*"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "dev"
      }
    },
    {
      "label": "Start All (Dev)",
      "dependsOn": [
        "Frontend: Angular",
        "Backend: Spring Boot"
      ],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
