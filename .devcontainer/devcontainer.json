{
	"name": "Java, Angular & PostgreSQL",
	"dockerComposeFile": "docker-compose.yml",
	"service": "app",
	"workspaceFolder": "/workspace",

	"features": {
		// Feature oficial do Node (mais estável que a do mise)
		"ghcr.io/devcontainers/features/node:1": {
			"version": "24"
		}
	},

	// "db:5432" encaminha a porta do container do banco (e não do container app)
	"forwardPorts": [8080, 4200, "db:5432"],
	"portsAttributes": {
		"8080": {"label": "Spring Server"},
		"4200": {"label": "Angular Server"},
		"db:5432": {"label": "PostgreSQL"}
	},

	"postCreateCommand": "npm install -g @angular/cli@21 && ng config -g cli.completion.prompted true && ng config -g cli.analytics false && git config --global --add safe.directory '*'",

	"customizations": {
		"vscode": {
			"settings": {
				"java.configuration.updateBuildConfiguration": "automatic"
			},
			"extensions": [
				// Extensões de Java e Spring
				"vscjava.vscode-java-pack",
				"vmware.vscode-boot-dev-pack",

				// Extensões de Angular
				"Angular.ng-template",

				// Tailwind
				"bradlc.vscode-tailwindcss",

				// Cliente de Banco de Dados
				"mtxr.sqltools",
				"mtxr.sqltools-driver-pg"
			]
		}
	}
}
